{
  "manifest_version": 3,
  "name": "SachMei — Live YouTube Fact Checker",
  "version": "1.0.0",
  "description": "Real-time AI-powered fact-checking for YouTube videos. Detects factual claims in video transcripts and verifies them instantly.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SachMei Fact Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "utils/text-utils.js",
        "utils/timestamp-utils.js",
        "services/cache-service.js",
        "services/transcript-service.js",
        "services/factcheck-service.js",
        "content/claim-detector.js",
        "content/transcript-manager.js",
        "content/ui-overlay.js",
        "content/youtube-content.js"
      ],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtubetranscript.com/*"
  ],

  "options_page": "options/options.html",

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "styles/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
